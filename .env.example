# For running locally. Copy to .env, fill in, then: set -a; source .env; set +a; npm run app   (or npm start for the Demo Console)
# Keep the quotes: values contain characters the shell would otherwise interpret.

OTEL_SERVICE_NAME="orders-live"
OTEL_EXPORTER_OTLP_ENDPOINT="http://otelcol.monoscope.tech:4317"
OTEL_EXPORTER_OTLP_PROTOCOL="grpc"
OTEL_RESOURCE_ATTRIBUTES="x-api-key=YOUR_MONOSCOPE_API_KEY,deployment.environment=local"

# Neon connection string (Neon dashboard > Connect)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

PORT=3000
# Set to false to turn off the built-in traffic simulator
SIMULATE=true

# --- Demo Console (npm start) ---
# console | burst | continuous. burst needs the x-api-key in OTEL_RESOURCE_ATTRIBUTES above.
DEMO_MODE="console"
# Optional passcode for the console
# DEMO_PASSCODE="choose-something"
# Burst mode tuning
SIM_BURST_EVERY_MINUTES=15
SIM_BURST_JOURNEYS=15
SIM_BURST_SECONDS=60
